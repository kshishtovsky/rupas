# Build artifacts: binaries only — build/ also holds runtime assets
# (WinDivert.dll/.sys, desync fake templates) that MUST stay tracked.
*.exe
*.exe~
*.dll
*.sys
!build/WinDivert.dll
!build/WinDivert64.sys
!build/windivert/**

# Release artifacts are built by scripts/make-dist.ps1 — never committed.
dist/
*.apk
*.zip

# Runtime logs, diagnostics captures, ad-hoc dumps.
*.log
*.out
*.err
*.txt
*.pcap
build/lab/
goroutines.txt

# Real configs and their backups carry secrets (uuid / password).
configs/rupas.yaml
configs/rupas.yaml.bak
configs/*.bak
configs/*.bak-*
configs/diag.yaml
out/

# Release signing key never leaves the machine — it goes to CI as a base64 secret.
android/keystore/
android/keystore.properties
android/app/libs/*.aar
