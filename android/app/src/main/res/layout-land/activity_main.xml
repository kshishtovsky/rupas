<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · macrostructure: app shell, wide · the floating bar keeps the column width -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/paper">

    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="@dimen/column_wide_shell"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal">

        <include
            android:id="@+id/viewTabHome"
            layout="@layout/tab_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <include
            android:id="@+id/viewTabSettings"
            layout="@layout/tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/viewTabLogs"
            layout="@layout/tab_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/column_wide"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_s"
        app:cardBackgroundColor="@color/paper_2"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
