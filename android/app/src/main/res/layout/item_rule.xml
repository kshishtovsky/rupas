<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · dose · rule row (§5.2): card, matcher in mono, human caption under it,
     action chip and overflow on the right. Drag handle appears only while dragging. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ruleRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_xs"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_xs"
    android:paddingBottom="@dimen/space_s">

    <TextView
        android:id="@+id/handleDrag"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/sym_drag_handle"
        android:textColor="@color/ink_faint"
        android:textSize="18sp"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxs"
        android:paddingEnd="@dimen/space_xs">

        <TextView
            android:id="@+id/tvMatcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <include
        layout="@layout/view_action_chip"
        android:layout_width="wrap_content"
        android:layout_height="26dp" />

    <TextView
        android:id="@+id/btnMenu"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/routing_more"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/sym_more"
        android:textColor="@color/ink_soft"
        android:textSize="18sp" />
</LinearLayout>
