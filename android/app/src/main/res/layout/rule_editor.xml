<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · dose · rule editor as a bottom sheet (§5.4)
     kind → value → protocol → action → Сохранить (52dp). Validation is client-side:
     empty, bad CIDR, bad port/range, port overlap with an existing rule. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper_2"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/rule_strong" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:text="@string/editor_new_rule"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <!-- Kind: one matcher, mutually exclusive (§2) -->
        <LinearLayout
            android:id="@+id/groupKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:fontFamily="sans-serif"
                android:text="@string/editor_kind"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupKindChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipKindIp"
                        style="@style/Widget.Rupas.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/editor_kind_ip" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipKindCountry"
                        style="@style/Widget.Rupas.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/editor_kind_country" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipKindDomain"
                        style="@style/Widget.Rupas.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/editor_kind_domain" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipKindPort"
                        style="@style/Widget.Rupas.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/editor_kind_port" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilValue"
            style="@style/Widget.Rupas.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:hint="@string/editor_value">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEditorError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:fontFamily="sans-serif"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Protocol -->
        <LinearLayout
            android:id="@+id/groupProto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/editor_proto"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/segProtoAny"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg"
                    android:backgroundTint="@color/seg_proto_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/proto_any"
                    android:textColor="@color/seg_proto_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/segProtoTcp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg"
                    android:backgroundTint="@color/seg_proto_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/proto_tcp"
                    android:textColor="@color/seg_proto_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/segProtoUdp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg"
                    android:backgroundTint="@color/seg_proto_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/proto_udp"
                    android:textColor="@color/seg_proto_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuicNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:fontFamily="sans-serif"
                android:text="@string/editor_quic_note"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Action: exactly four, fixed colour per action (§5.3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/editor_action"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/segActionDirect"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_xxs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg"
                    android:backgroundTint="@color/action_direct_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/action_direct"
                    android:textColor="@color/action_direct_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/segActionTunnel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_xxs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg"
                    android:backgroundTint="@color/action_tunnel_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/action_tunnel"
                    android:textColor="@color/action_tunnel_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/segActionDesync"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_xxs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg"
                    android:backgroundTint="@color/action_desync_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/action_desync"
                    android:textColor="@color/action_desync_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/segActionBlock"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_seg"
                    android:backgroundTint="@color/action_block_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/action_block"
                    android:textColor="@color/action_block_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:fontFamily="sans-serif"
                android:text="@string/action_direct_hint"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditorSave"
            style="@style/Widget.Rupas.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/editor_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
