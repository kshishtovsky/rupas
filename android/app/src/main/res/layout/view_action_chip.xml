<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · dose · action chip (§5.3): 6dp dot + text, colour set per action in code.
     Text, never an icon — the four actions are words (DIRECT/TUNNEL/DESYNC/BLOCK). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chipAction"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:background="@drawable/bg_chip_action"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <View
        android:id="@+id/dotAction"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_dot" />

    <TextView
        android:id="@+id/tvAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:textSize="11sp" />
</LinearLayout>
