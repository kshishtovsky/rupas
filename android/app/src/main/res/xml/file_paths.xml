<?xml version="1.0" encoding="utf-8"?>
<!-- Выгрузка журнала: файлы из cache/logs шарятся через ACTION_SEND (MainActivity.shareLogs). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="logs"
        path="logs/" />
    <!-- Скачанный APK обновления (UpdateChecker) отдаётся установщику через FileProvider -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
