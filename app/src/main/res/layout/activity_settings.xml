<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- UUID: маскируется точками, глаз справа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etUuid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_uuid"
                android:inputType="text"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnToggleUuid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="@string/eye_closed" />
        </LinearLayout>

        <EditText
            android:id="@+id/etServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_server"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_port"
            android:inputType="number"
            android:maxLength="5" />

        <EditText
            android:id="@+id/etSni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sni"
            android:inputType="textUri" />

        <!-- publicKey (reality pbk): маскируется точками, глаз справа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etPublicKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_public_key"
                android:inputType="text"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnTogglePbk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="@string/eye_closed" />
        </LinearLayout>

        <EditText
            android:id="@+id/etShortId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_short_id"
            android:inputType="text"
            android:fontFamily="monospace" />

        <CheckBox
            android:id="@+id/cbFallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/hint_fallback" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_import" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save" />
    </LinearLayout>
</ScrollView>
